# Pinned upstream Pocknix image for the Retroid Pocket 5 (SM8250).
# This repo does not build or fork the image. scripts/flash-sd.sh downloads
# this file, checks it against the published checksum, and writes it to a microSD.
#
# After the device is installed, Pocknix updates through pacman. Reflash only
# for a new machine or when upstream says a reflash is required.
# To move the pin, update every value together and confirm the checksum from
# https://github.com/shuuri-labs/pocknix-os/releases/latest

POCKNIX_VERSION=v0.4.0
POCKNIX_SOC=sm8250
POCKNIX_IMAGE=pocknix-sm8250-20260912-sd.img.zst
POCKNIX_URL=https://pocknix.shuuri.net/images/pocknix-sm8250-20260912-sd.img.zst
POCKNIX_SHA256=350603f4c136798cd3136879d2fc6e1ab9575038eef3e76132ef10979fb5e19e
POCKNIX_SHA_URL=https://github.com/shuuri-labs/pocknix-os/releases/download/v0.4.0/pocknix-sm8250-20260912-sd.img.zst.sha256
POCKNIX_MIN_DISK_BYTES=60000000000
