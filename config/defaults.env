# Non-secret defaults copied to /etc/rp5-llm/defaults.env on the device.
# The inference API stays on localhost until a later change enables LAN access.

RP5_LLM_BIND=127.0.0.1
RP5_LLM_PORT=8080
RP5_LLM_LLAMA_URL=http://127.0.0.1:8081
RP5_LLM_BACKEND=cpu
RP5_LLM_PREFIX=/opt/rp5-llm
RP5_LLM_STATE=/var/lib/rp5-llm
RP5_LLM_CONFIG=/etc/rp5-llm
RP5_LLM_USER=deck
RP5_UI_KIOSK=false
RP5_LLM_EXPOSE_LAN=false
RP5_LLM_CAPTURE_CONTENT=false
RP5_LLM_HISTORY_LIMIT=1000
RP5_LLM_HISTORY_DAYS=7
